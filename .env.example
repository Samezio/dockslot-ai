# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Which provider app/llm.py uses. One of:
#   google_genai, openai, openrouter, aicredit, ollama
LLM_PROVIDER=google_genai

# Only the key(s) for your chosen LLM_PROVIDER are required.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPEN_ROUNTER_API_KEY=

# aicredit -- an OpenAI-compatible gateway. Both are required for that
# provider; the base URL is account-specific so there's no default.
AICREDIT_API_KEY=
AICREDIT_BASE_URL=

# ollama is local dev only -- no key needed. Only set this if your Ollama
# server isn't at the default http://localhost:11434.
# Note: a local 8B model takes 2-5 MINUTES per message on CPU. Fine for
# offline testing, not for a live demo -- see docs/developer/development.md.
OLLAMA_BASE_URL=

# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Which provider app/llm.py uses by default. One of: google_genai, openai, openrouter.
LLM_PROVIDER=google_genai

# Only the key(s) for your chosen LLM_PROVIDER are required.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPEN_ROUNTER_API_KEY=

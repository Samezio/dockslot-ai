# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Which provider app/llm.py uses by default. One of: google_genai, openai, openrouter, ollama.
LLM_PROVIDER=google_genai

# Only the key(s) for your chosen LLM_PROVIDER are required.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPEN_ROUNTER_API_KEY=

# ollama is local dev only -- no key needed. Only set this if your Ollama
# server isn't at the default http://localhost:11434.
OLLAMA_BASE_URL=
